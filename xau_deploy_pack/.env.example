# ===== CORE RUNTIME =====
APP_ENV=production
TRADING_ENABLED=false
LOG_LEVEL=INFO
TZ=UTC

# ===== BOT MODE =====
# alerts_only | semi_auto | full_auto
BOT_MODE=alerts_only
BROKER_MODE=paper
TP_VARIANT=A

# ===== OANDA =====
OANDA_API_TOKEN=replace_me
OANDA_ACCOUNT_ID=replace_me
OANDA_ENV=practice
OANDA_INSTRUMENT=XAU_USD

# ===== TELEGRAM ALERTS =====
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHAT_ID=replace_me

# ===== DATABASE =====
DATABASE_URL=sqlite:///./data/journal.sqlite3

# ===== MARKET DATA SOURCES =====
# Replace with your actual adapters / feeds
MARKET_DATA_SOURCE=csv
CSV_M15_PATH=./data/xau_m15.csv
CSV_H1_PATH=./data/xau_h1.csv
CSV_D1_PATH=./data/xau_d1.csv

# ===== CALENDAR / NEWS =====
CALENDAR_SOURCE=file
CALENDAR_FILE=./data/calendar_events.json

# ===== RUNTIME SCHEDULING =====
SIGNAL_CHECK_INTERVAL_SECONDS=30
TRADE_MANAGEMENT_INTERVAL_SECONDS=10

# ===== SAFETY =====
MAX_CONSECUTIVE_ERRORS=5
HEALTHCHECK_ENABLED=true
HEALTHCHECK_FILE=./runtime/healthcheck.json
